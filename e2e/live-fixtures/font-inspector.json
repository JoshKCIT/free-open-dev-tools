{
  "id": "font-inspector",
  "label": "a 1,672 byte TrueType font built with fontTools 4.64.0 shows its family Det Sans and its licence text from name ID 13",
  "steps": [
    {
      "action": "attach",
      "field": "file",
      "files": [
        {
          "name": "det-sans.ttf",
          "mimeType": "font/ttf",
          "base64": ""
        }
      ]
    },
    {
      "action": "run"
    }
  ],
  "expect": ["Det Sans", "Test font built for this project, released as CC0-1.0."]
}
