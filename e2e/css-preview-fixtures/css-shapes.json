{
  "id": "css-shapes",
  "scenarios": [
    {
      "label": "triangle by borders",
      "steps": [
        {
          "action": "radio",
          "field": "shape",
          "value": "triangle"
        },
        {
          "action": "select",
          "field": "direction",
          "value": "up-left"
        },
        {
          "action": "radio",
          "field": "method",
          "value": "border"
        }
      ],
      "pixels": true,
      "expectCss": ["border-top: 80px solid #1d4ed8", "border-right: 160px solid transparent"]
    },
    {
      "label": "triangle by clip-path",
      "steps": [
        {
          "action": "radio",
          "field": "shape",
          "value": "triangle"
        },
        {
          "action": "select",
          "field": "direction",
          "value": "down-right"
        },
        {
          "action": "radio",
          "field": "method",
          "value": "clip-path"
        }
      ],
      "pixels": true,
      "expectCss": ["clip-path: polygon(100% 0, 100% 100%, 0 100%)"]
    },
    {
      "label": "speech bubble",
      "steps": [
        {
          "action": "radio",
          "field": "shape",
          "value": "bubble"
        },
        {
          "action": "select",
          "field": "tail",
          "value": "bottom-right"
        },
        {
          "action": "fill",
          "field": "text",
          "value": "Hi there"
        }
      ],
      "pixels": true,
      "expectCss": ["right: 20px", "border-left: 16px solid transparent"]
    },
    {
      "label": "tooltip",
      "steps": [
        {
          "action": "radio",
          "field": "shape",
          "value": "tooltip"
        },
        {
          "action": "select",
          "field": "tail",
          "value": "top"
        },
        {
          "action": "fill",
          "field": "text",
          "value": "Copied"
        }
      ],
      "pixels": true,
      "expectCss": ["bottom: 100%", "border-bottom: 10px solid #dbeafe"]
    },
    {
      "label": "ribbon",
      "steps": [
        {
          "action": "radio",
          "field": "shape",
          "value": "ribbon"
        },
        {
          "action": "fill",
          "field": "text",
          "value": "New"
        }
      ],
      "pixels": true,
      "expectCss": ["clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 60% 50%)"]
    }
  ]
}
