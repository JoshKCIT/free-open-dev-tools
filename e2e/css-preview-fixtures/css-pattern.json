{
  "id": "css-pattern",
  "scenarios": [
    {
      "label": "diagonal stripes",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "stripes-diagonal"
        },
        {
          "action": "radio",
          "field": "output",
          "value": "gradient"
        }
      ],
      "expectCss": ["repeating-linear-gradient(45deg"]
    },
    {
      "label": "horizontal stripes",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "stripes-horizontal"
        }
      ],
      "expectCss": ["repeating-linear-gradient(180deg"]
    },
    {
      "label": "vertical stripes",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "stripes-vertical"
        }
      ],
      "expectCss": ["repeating-linear-gradient(90deg"]
    },
    {
      "label": "checks",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "checks"
        }
      ],
      "expectCss": ["repeating-conic-gradient"]
    },
    {
      "label": "dots",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "dots"
        }
      ],
      "expectCss": ["radial-gradient(circle at 50% 50%"]
    },
    {
      "label": "grid",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "grid"
        }
      ],
      "expectCss": ["repeating-linear-gradient(90deg", "repeating-linear-gradient(0deg"]
    },
    {
      "label": "zigzag",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "zigzag"
        }
      ],
      "expectCss": ["linear-gradient(135deg", "linear-gradient(315deg"]
    },
    {
      "label": "cross-hatch",
      "steps": [
        {
          "action": "radio",
          "field": "pattern",
          "value": "cross"
        }
      ],
      "expectCss": ["repeating-linear-gradient(45deg", "repeating-linear-gradient(135deg"]
    }
  ]
}
