#!/bin/sh
# Runs the forbidden-reference gate again, this time with the commit message
# included. git only hands the message file to the commit-msg hook, not
# pre-commit, which is why this is a second hook rather than one combined script.
#
# It is turned on together with pre-commit: git config core.hooksPath .githooks
node scripts/check-provenance.mjs --commit-message-file "$1"
exit $?
