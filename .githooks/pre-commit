#!/bin/sh
# Runs the forbidden-reference gate (scripts/check-provenance.mjs) before each
# commit, over the tracked files and, when one has been built, the built site.
# CI runs the same gate on every push and pull request and is the real
# enforcement; this hook only saves a contributor a round trip.
#
# Turn it on once per clone with: git config core.hooksPath .githooks
# Without the git-ignored .provenance-denylist file it prints a warning and
# runs a reduced check instead of failing.
node scripts/check-provenance.mjs
exit $?
