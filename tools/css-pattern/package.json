{
  "name": "@fodt/css-pattern",
  "version": "1.0.0",
  "description": "Build repeating stripes, checks, dots and grids as CSS gradients or an inline SVG, with a live preview.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "css pattern",
    "background pattern",
    "stripes",
    "checkerboard",
    "polka dots",
    "grid background",
    "zigzag",
    "svg pattern",
    "repeating-linear-gradient"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/css-pattern"
  }
}
