{
  "name": "@fodt/qr-generator",
  "version": "1.0.0",
  "description": "Generate QR codes for text, URLs, WiFi, vCard, email and SMS payloads.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "qr code",
    "qr code generator",
    "wifi qr code",
    "vcard qr code",
    "mailto",
    "sms qr code",
    "iso 18004"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "@zxing/library": "0.21.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/qr-generator"
  }
}
