{
  "name": "@fodt/msgpack-cbor",
  "version": "1.0.0",
  "description": "Convert MessagePack and CBOR to JSON and back, from hex, Base64 or a file, with binary values and tags kept visible.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "messagepack",
    "msgpack",
    "cbor",
    "rfc 8949",
    "binary json",
    "diagnostic notation",
    "hex",
    "base64",
    "tag"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/msgpack-cbor"
  }
}
