{
  "name": "@fodt/web-manifest-builder",
  "version": "1.0.0",
  "description": "Build a web app manifest with its name, icons, colours, display mode and start address, each member checked.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "web app manifest",
    "manifest.webmanifest",
    "pwa",
    "progressive web app",
    "w3c",
    "icons",
    "theme color",
    "start_url",
    "scope"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/web-manifest-builder"
  }
}
