{
  "name": "@fodt/hash-text",
  "version": "1.0.0",
  "description": "Compute MD5, SHA-1, SHA-2, SHA-3, BLAKE and CRC32 digests, CRC-16, CRC-32C and Adler-32 checksums, SHAKE, MD4 and NTLM over text.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "hash",
    "md5",
    "sha256",
    "sha1",
    "crc32",
    "checksum",
    "digest",
    "sha3",
    "sha512/256",
    "sha512/224",
    "blake2",
    "blake2b",
    "blake2s",
    "blake3",
    "crc16",
    "crc32c",
    "adler32",
    "shake",
    "shake128",
    "shake256",
    "md4",
    "ntlm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/hash-text"
  }
}
