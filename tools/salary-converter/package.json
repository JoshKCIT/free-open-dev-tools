{
  "name": "@fodt/salary-converter",
  "version": "1.0.0",
  "description": "Convert pay between yearly, monthly, fortnightly, weekly, daily and hourly amounts for chosen hours per week and weeks per year.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "salary converter",
    "hourly to yearly",
    "yearly to hourly",
    "pay converter",
    "annual salary",
    "weekly pay",
    "fortnightly pay",
    "monthly salary",
    "day rate",
    "hourly pay"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/salary-converter"
  }
}
