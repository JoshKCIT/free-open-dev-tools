{
  "name": "@fodt/qr-barcode-reader",
  "version": "1.0.0",
  "description": "Read QR codes and common barcodes from an image file or your camera, entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "qr",
    "qr code",
    "barcode",
    "scanner",
    "reader",
    "ean",
    "upc",
    "code 128",
    "data matrix",
    "zxing",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "qrcode": "1.5.4",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "@zxing/library": "0.21.3",
    "@napi-rs/canvas": "^1.0.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/qr-barcode-reader"
  }
}
