{
  "name": "@fodt/unit-converter",
  "version": "1.0.0",
  "description": "Convert length, mass, temperature, volume, area, speed, pressure, energy, power, angle, fuel economy, charge, frequency and time.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "unit converter",
    "units",
    "conversion",
    "metric",
    "imperial",
    "temperature",
    "pressure",
    "fuel economy",
    "mpg",
    "exact factors",
    "decimal"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/unit-converter"
  }
}
