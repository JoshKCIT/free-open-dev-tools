{
  "name": "@fodt/contrast-checker",
  "version": "1.0.0",
  "description": "Check WCAG 2.2 contrast ratios and report the APCA lightness contrast.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "css",
    "colour",
    "color",
    "contrast",
    "wcag",
    "apca",
    "accessibility",
    "a11y"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "css-tree": "^3.2.1",
    "@types/css-tree": "^3.2.0",
    "colorjs.io": "^0.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/contrast-checker"
  }
}
