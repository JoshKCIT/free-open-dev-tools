{
  "name": "@fodt/data-to-sql",
  "version": "1.0.0",
  "description": "Generate CREATE TABLE and INSERT statements for a chosen SQL dialect, or turn INSERT statements back into CSV or JSON rows.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "sql",
    "csv",
    "json",
    "postgresql",
    "mysql",
    "sqlite",
    "sql server",
    "create table",
    "insert",
    "ddl",
    "insert to json",
    "sql to csv",
    "sql to json",
    "read insert statements",
    "parse sql dump"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "sql.js": "1.14.2",
    "@types/sql.js": "1.4.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/data-to-sql"
  }
}
