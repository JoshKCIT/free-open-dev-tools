{
  "name": "@fodt/cubic-bezier",
  "version": "1.0.0",
  "description": "Shape a cubic-bezier easing curve by dragging its handles or picking a preset, and preview the motion.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "cubic-bezier",
    "easing",
    "timing function",
    "ease-in-out",
    "transition-timing-function",
    "animation curve",
    "bezier editor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/cubic-bezier"
  }
}
