{
  "name": "@fodt/depreciation",
  "version": "1.0.0",
  "description": "Build a depreciation schedule by straight line, declining balance with a switch to straight line, sum of the years digits or units of production.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "depreciation",
    "straight line",
    "declining balance",
    "double declining balance",
    "sum of the years digits",
    "units of production",
    "book value",
    "salvage value",
    "useful life",
    "depreciation schedule"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/depreciation"
  }
}
