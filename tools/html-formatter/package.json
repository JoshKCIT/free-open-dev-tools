{
  "name": "@fodt/html-formatter",
  "version": "1.0.0",
  "description": "Beautify or minify HTML without executing it.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "html",
    "format",
    "beautify",
    "minify",
    "prettier",
    "html-minifier-terser"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prettier": "3.9.9",
    "html-minifier-terser": "7.2.0",
    "csso": "5.0.5",
    "terser": "5.51.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/csso": "^5.0.5",
    "parse5": "^8.0.1",
    "jsdom": "^29.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/html-formatter"
  }
}
