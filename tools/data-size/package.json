{
  "name": "@fodt/data-size",
  "version": "1.0.0",
  "description": "Convert between bits, bytes and their SI and IEC multiples, convert speeds, and work out transfer times.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "data size",
    "byte converter",
    "bit converter",
    "transfer time",
    "bandwidth",
    "KiB",
    "MiB",
    "GiB",
    "kbit",
    "Mbit"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/data-size"
  }
}
