{
  "name": "@fodt/mermaid-renderer",
  "version": "1.0.0",
  "description": "Render a Mermaid diagram description to SVG or PNG with syntax errors shown and nothing fetched.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "sequence",
    "svg",
    "png",
    "uml",
    "gantt",
    "chart"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/mermaid-renderer"
  }
}
