{
  "name": "@fodt/pkce-builder",
  "version": "1.0.0",
  "description": "Make a PKCE verifier and challenge, build an OAuth 2.0 authorization request and read the code or error out of a redirect address, all offline.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "pkce",
    "oauth",
    "oauth2",
    "oidc",
    "openid connect",
    "code verifier",
    "code challenge",
    "s256",
    "authorization request",
    "redirect uri",
    "state",
    "nonce"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/pkce-builder"
  }
}
