{
  "name": "@fodt/pdf-text-metadata",
  "version": "1.0.0",
  "description": "Extract a PDF's text page by page, view its metadata and download a copy with the metadata removed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "src/pdf-worker-entry.ts"
  ],
  "keywords": [
    "pdf",
    "text",
    "extract",
    "metadata",
    "xmp",
    "author",
    "remove",
    "sanitize",
    "pdfjs",
    "pdf-lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "@cantoo/pdf-lib": "2.11.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@napi-rs/canvas": "^1.0.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/pdf-text-metadata"
  }
}
