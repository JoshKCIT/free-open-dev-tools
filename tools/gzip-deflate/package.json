{
  "name": "@fodt/gzip-deflate",
  "version": "1.0.0",
  "description": "Compress text to gzip, zlib or raw deflate as Base64 or hex, and decompress it back, with integrity checks and a size cap.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "gzip",
    "zlib",
    "deflate",
    "decompress",
    "compress",
    "inflate",
    "crc32",
    "adler32"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/gzip-deflate"
  }
}
