{
  "name": "@fodt/form-control-styler",
  "version": "1.0.0",
  "description": "Style buttons, switches, checkboxes, radio buttons and range sliders while keeping the native controls.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "form control",
    "custom checkbox",
    "toggle switch",
    "css switch",
    "radio button",
    "range slider",
    "styled button",
    "accent-color",
    "focus-visible"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/form-control-styler"
  }
}
