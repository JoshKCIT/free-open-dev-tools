{
  "name": "@fodt/image-converter",
  "version": "1.0.0",
  "description": "Convert, resize, crop, rotate and flip images, and turn SVG into a raster image, entirely in the browser canvas.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "image",
    "convert",
    "resize",
    "png",
    "jpeg",
    "webp",
    "avif",
    "canvas",
    "crop",
    "rotate",
    "flip",
    "svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/image-converter"
  }
}
