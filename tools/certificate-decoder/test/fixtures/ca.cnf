[req]
distinguished_name=dn
prompt=no
string_mask=utf8only
utf8=yes
[dn]
C=GB
O=Example Root Ltd
CN=Example Root CA
[v3_root]
basicConstraints=critical,CA:TRUE,pathlen:1
keyUsage=critical,keyCertSign,cRLSign
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid:always
[v3_int]
basicConstraints=critical,CA:TRUE,pathlen:0
keyUsage=critical,keyCertSign,cRLSign
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid:always
crlDistributionPoints=URI:http://crl.example.invalid/root.crl
authorityInfoAccess=OCSP;URI:http://ocsp.example.invalid,caIssuers;URI:http://ca.example.invalid/root.crt
nameConstraints=permitted;DNS:example.com,excluded;IP:10.0.0.0/255.0.0.0
certificatePolicies=2.5.29.32.0
[v3_leaf]
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth,clientAuth,codeSigning,emailProtection
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid
subjectAltName=DNS:example.com,DNS:*.example.com,IP:192.0.2.1,IP:2001:db8::1,email:admin@example.com,URI:https://example.com/path,otherName:1.3.6.1.4.1.311.20.2.3;UTF8:user@example.com,dirName:dn_alt,RID:1.2.3.4
crlDistributionPoints=URI:http://crl.example.invalid/int.crl
authorityInfoAccess=OCSP;URI:http://ocsp.example.invalid,caIssuers;URI:http://ca.example.invalid/int.crt
certificatePolicies=2.23.140.1.2.1,1.3.6.1.4.1.99999.1
1.3.6.1.4.1.11129.2.4.2=ASN1:NULL
[dn_alt]
CN=Alt Name
C=US
[req_san]
subjectAltName=DNS:csr.example.com,DNS:www.csr.example.com,IP:192.0.2.7,email:csr@example.com
basicConstraints=CA:FALSE
keyUsage=digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
[v3_canary]
basicConstraints=critical,CA:FALSE
subjectAltName=DNS:canary.example.test,URI:http://127.0.0.1:65535/san-uri
crlDistributionPoints=URI:http://127.0.0.1:65535/crl
authorityInfoAccess=OCSP;URI:http://127.0.0.1:65535/ocsp,caIssuers;URI:http://127.0.0.1:65535/issuer.crt
certificatePolicies=@canary_policy
[canary_policy]
policyIdentifier=1.3.6.1.4.1.99999.1
CPS.1=http://127.0.0.1:65535/cps
