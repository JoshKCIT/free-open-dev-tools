{
  "name": "@fodt/sales-tax",
  "version": "1.0.0",
  "description": "Add sales tax, VAT or GST to a net amount or take it out of a gross amount, with several tax components and rounding per line or on the total.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "sales tax",
    "VAT",
    "GST",
    "VAT fraction",
    "add tax",
    "remove tax",
    "tax inclusive",
    "tax exclusive",
    "gross to net",
    "net to gross",
    "rounding"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/sales-tax"
  }
}
