{
  "name": "@fodt/form-field-builder",
  "version": "1.0.0",
  "description": "Build one accessible form field of any HTML input type, a textarea or a select, with its label, name, validation attributes and autocomplete token, and preview it safely.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "html",
    "form",
    "input",
    "label",
    "autocomplete",
    "accessibility",
    "markup generator"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "parse5": "8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/form-field-builder"
  }
}
