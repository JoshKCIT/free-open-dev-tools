{
  "name": "@fodt/keyboard-event-viewer",
  "version": "1.0.0",
  "description": "Press keys and see the key, code, legacy key code, location, modifiers, repeat and composition state the browser reports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "keyboard",
    "key",
    "keycode",
    "event",
    "keydown",
    "keyup",
    "keypress",
    "code",
    "location",
    "composition",
    "ime",
    "which"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/keyboard-event-viewer"
  }
}
