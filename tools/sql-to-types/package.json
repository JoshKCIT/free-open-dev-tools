{
  "name": "@fodt/sql-to-types",
  "version": "1.0.0",
  "description": "Turn CREATE TABLE statements into TypeScript, Prisma or Drizzle definitions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "sql",
    "typescript",
    "prisma",
    "drizzle",
    "create table",
    "schema",
    "types",
    "postgresql",
    "mysql",
    "sqlite",
    "sql server"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/sql-to-types"
  }
}
