{
  "name": "@fodt/css-spinner",
  "version": "1.0.0",
  "description": "Make pure-CSS loading spinners in a chosen size, colour and speed that stop for reduced motion.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "css spinner",
    "loading spinner",
    "loader",
    "css animation",
    "keyframes",
    "prefers-reduced-motion",
    "ring",
    "ripple",
    "pulse"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/css-spinner"
  }
}
