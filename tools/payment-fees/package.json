{
  "name": "@fodt/payment-fees",
  "version": "1.0.0",
  "description": "Work out the fee on a payment and the amount received from a percentage and fixed fee you type in, or the amount to charge to receive a chosen sum.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "payment fee",
    "processing fee",
    "transaction fee",
    "percentage fee",
    "fixed fee",
    "amount received",
    "gross up",
    "net amount",
    "charge to receive"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/payment-fees"
  }
}
