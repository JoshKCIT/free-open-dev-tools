{
  "name": "@fodt/currency-markup",
  "version": "1.0.0",
  "description": "Compare an offered exchange rate with a reference mid-market rate you type in, and see the markup as a percentage and the hidden cost in each currency.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "currency conversion",
    "exchange rate",
    "markup",
    "mid-market rate",
    "hidden cost",
    "foreign exchange",
    "card fees",
    "bank rate",
    "reference rate"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/currency-markup"
  }
}
