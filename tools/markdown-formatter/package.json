{
  "name": "@fodt/markdown-formatter",
  "version": "1.0.0",
  "description": "Reformat Markdown consistently, aligning tables and normalising lists, emphasis and headings.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "markdown",
    "mdx",
    "format",
    "prettier",
    "table",
    "gfm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prettier": "3.9.9"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/markdown-formatter"
  }
}
