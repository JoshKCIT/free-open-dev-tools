{
  "name": "@fodt/c-family-formatter",
  "version": "1.0.0",
  "description": "Format C, C++, C#, Java, Objective-C and Protocol Buffers source with clang-format under a named style preset and a chosen indent width.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "c",
    "c++",
    "cpp",
    "c#",
    "csharp",
    "java",
    "objective-c",
    "protobuf",
    "proto",
    "clang-format",
    "format",
    "formatter",
    "pretty-print",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wasm-fmt/clang-format": "23.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/c-family-formatter"
  }
}
