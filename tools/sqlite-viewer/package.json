{
  "name": "@fodt/sqlite-viewer",
  "version": "1.0.0",
  "description": "Browse a SQLite database's tables and schema, run SQL on an in-memory copy, export results and download the changed file.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "sqlite",
    "sqlite3",
    "database",
    "sql",
    "query",
    "schema",
    "viewer",
    "sql.js",
    "wasm",
    "csv"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/sql.js": "1.4.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/sqlite-viewer"
  }
}
