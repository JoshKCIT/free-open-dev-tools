{
  "name": "@fodt/conventional-commit",
  "version": "1.0.0",
  "description": "Check commit messages against Conventional Commits 1.0.0 and see the version bump they add up to and a draft changelog.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "conventional commits",
    "commit message",
    "commitlint",
    "semver",
    "version bump",
    "changelog",
    "breaking change",
    "feat",
    "fix",
    "git log"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/conventional-commit"
  }
}
