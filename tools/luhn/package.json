{
  "name": "@fodt/luhn",
  "version": "1.0.0",
  "description": "Validate or compute check digits for card numbers (Luhn), ISBN, EAN, UPC, IBAN, VIN and ISIN, and name a card number's issuer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "luhn",
    "luhn algorithm",
    "card",
    "credit card",
    "check digit",
    "card number validator",
    "mod 10",
    "mod 97",
    "issuer identification number",
    "isbn",
    "isbn-10",
    "isbn-13",
    "ean-8",
    "ean-13",
    "upc-a",
    "gtin",
    "barcode",
    "iban",
    "vin",
    "isin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/luhn"
  }
}
