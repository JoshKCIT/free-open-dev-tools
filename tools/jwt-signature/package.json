{
  "name": "@fodt/jwt-signature",
  "version": "1.0.0",
  "description": "Sign and verify JWTs with HMAC, RSA and ECDSA using the browser crypto API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "jwt",
    "jws",
    "jose",
    "hmac",
    "rsa",
    "ecdsa",
    "sign",
    "verify",
    "webcrypto",
    "rfc7515",
    "rfc7518"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/jwt-signature"
  }
}
