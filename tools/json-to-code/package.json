{
  "name": "@fodt/json-to-code",
  "version": "1.0.0",
  "description": "Generate TypeScript, Go, Rust, Python, Java, C#, Kotlin and PHP types from JSON.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "json",
    "code generation",
    "typescript",
    "go",
    "rust",
    "python",
    "java",
    "csharp",
    "kotlin",
    "php",
    "type inference"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/json-to-code"
  }
}
