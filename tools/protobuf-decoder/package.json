{
  "name": "@fodt/protobuf-decoder",
  "version": "1.0.0",
  "description": "Decode raw Protocol Buffers bytes without a schema into field numbers, wire types and the values they could hold.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "protobuf",
    "protocol buffers",
    "proto",
    "wire format",
    "varint",
    "zigzag",
    "decode raw",
    "no schema",
    "hex",
    "base64"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/protobuf-decoder"
  }
}
