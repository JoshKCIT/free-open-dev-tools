{
  "name": "@fodt/js-formatter",
  "version": "1.0.0",
  "description": "Beautify or minify JavaScript and TypeScript without running it.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "javascript",
    "typescript",
    "format",
    "beautify",
    "minify",
    "prettier",
    "terser"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prettier": "3.9.9",
    "terser": "5.51.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@babel/parser": "^7.29.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/js-formatter"
  }
}
