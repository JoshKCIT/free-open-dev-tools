{
  "name": "@fodt/shell-formatter",
  "version": "1.0.0",
  "description": "Format shell scripts for POSIX sh, bash or mksh with shfmt and a chosen indent, with syntax errors shown by line and column.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "shell",
    "sh",
    "bash",
    "mksh",
    "posix",
    "shfmt",
    "format",
    "formatter",
    "pretty-print",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wasm-fmt/shfmt": "0.2.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/shell-formatter"
  }
}
