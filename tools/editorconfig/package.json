{
  "name": "@fodt/editorconfig",
  "version": "1.0.0",
  "description": "Paste .editorconfig files and a file path to see which properties apply and which file, section and line decided each.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "editorconfig",
    ".editorconfig",
    "indent_style",
    "indent_size",
    "tab_width",
    "end_of_line",
    "charset",
    "root",
    "glob",
    "properties"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/editorconfig"
  }
}
