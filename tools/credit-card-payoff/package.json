{
  "name": "@fodt/credit-card-payoff",
  "version": "1.0.0",
  "description": "See how long several card balances take to clear at a chosen monthly payment, or the payment that clears them by a chosen month, highest rate first or smallest balance first.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "credit card payoff",
    "debt payoff",
    "debt avalanche",
    "debt snowball",
    "highest rate first",
    "smallest balance first",
    "minimum payment",
    "months to pay off",
    "interest",
    "APR"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/credit-card-payoff"
  }
}
