{
  "name": "@fodt/set-cookie-inspector",
  "version": "1.0.0",
  "description": "Paste Set-Cookie lines and see whether a browser would store each cookie, how long it lives, where it is sent and why one is refused.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "cookie",
    "set-cookie",
    "samesite",
    "httponly",
    "secure",
    "max-age",
    "expires",
    "__host-",
    "__secure-",
    "rfc6265bis"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "tough-cookie": "6.0.2",
    "cookie": "1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/set-cookie-inspector"
  }
}
