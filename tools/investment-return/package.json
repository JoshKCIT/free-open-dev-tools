{
  "name": "@fodt/investment-return",
  "version": "1.0.0",
  "description": "Work out profit or loss, return on investment and annualised return from buy and sell prices or start and end values, quantities, fees and dates.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "investment return",
    "return on investment",
    "ROI",
    "annualised return",
    "annualized return",
    "profit and loss",
    "total return",
    "holding period",
    "cost basis",
    "average annual total return"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/investment-return"
  }
}
