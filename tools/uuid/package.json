{
  "name": "@fodt/uuid",
  "version": "1.0.0",
  "description": "Generate and decode UUIDs (v1, v3, v4, v5 and v7), ULIDs, NanoIDs, KSUIDs, Snowflake IDs and ObjectIds, with the times they carry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "uuid",
    "guid",
    "uuidv4",
    "uuidv7",
    "rfc9562",
    "identifier",
    "ulid",
    "nanoid",
    "ksuid",
    "snowflake",
    "objectid",
    "mongodb"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/uuid"
  }
}
