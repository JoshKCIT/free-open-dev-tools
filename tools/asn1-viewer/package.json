{
  "name": "@fodt/asn1-viewer",
  "version": "1.0.0",
  "description": "Paste PEM, Base64 or hex, or open a file, and read any DER or BER structure as a tree with offsets, tags, lengths, values and named object identifiers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "ASN.1",
    "DER",
    "BER",
    "PEM",
    "X.690",
    "object identifier",
    "OID",
    "TLV",
    "tree",
    "asn1parse"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/asn1-viewer"
  }
}
