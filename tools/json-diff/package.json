{
  "name": "@fodt/json-diff",
  "version": "1.0.0",
  "description": "Compare two JSON documents, list every change, and generate or apply RFC 6902 JSON Patch and RFC 7386 Merge Patch.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "json",
    "diff",
    "compare",
    "json pointer",
    "rfc6901",
    "structural diff",
    "json patch",
    "rfc6902",
    "merge patch",
    "rfc7386",
    "rfc7396",
    "patch"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/json-diff"
  }
}
