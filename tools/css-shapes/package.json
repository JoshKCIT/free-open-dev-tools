{
  "name": "@fodt/css-shapes",
  "version": "1.0.0",
  "description": "Draw triangles, ribbons, speech bubbles and tooltip arrows in pure CSS with a live preview.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta.json": "./src/meta.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "css shapes",
    "css triangle",
    "css arrow",
    "speech bubble",
    "tooltip arrow",
    "ribbon",
    "clip-path",
    "border triangle",
    "callout"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshKCIT/free-open-dev-tools.git",
    "directory": "tools/css-shapes"
  }
}
